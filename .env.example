# Copy this file on the VPS to /var/www/clicker/.env and replace the secret.
CLICKER_SECRET_KEY=replace-with-a-long-random-secret
CLICKER_DATABASE_PATH=/var/www/clicker/data/clicker.db
CLICKER_COOKIE_SECURE=true
CLICKER_CERTBOT_EMAIL=replace-with-your-email@example.com
# Generate both hashes with admin_credentials.py --env /var/www/clicker/.env.
# Empty values disable administrator login. Never put plaintext credentials here.
CLICKER_ADMIN_LOGIN_HASH=
CLICKER_ADMIN_PASSWORD_HASH=
