[Unit]
Description=Clicker Flask application
After=network.target

[Service]
Type=exec
User=clicker
Group=clicker
WorkingDirectory=/var/www/clicker/app
EnvironmentFile=/var/www/clicker/.env
RuntimeDirectory=clicker
RuntimeDirectoryMode=0755
ExecStart=/var/www/clicker/venv/bin/gunicorn --workers 2 --bind unix:/run/clicker/gunicorn.sock --umask 007 app:app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/www/clicker/data

[Install]
WantedBy=multi-user.target
